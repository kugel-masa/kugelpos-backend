# < MongoDB >
#
# connection string
MONGODB_URI=your_mongodb_uri
# Database name
DB_NAME_PREFIX=your_database_name

#
# < Web Service >
#
# Base URL for the dapr sidecar
# e.g. http://localhost:3500/v1.0
BASE_URL_DAPR=http://localhost:3503/v1.0
# Base URL for the master data service
# e.g. http://master-data.myserver.com/api/v1
BASE_URL_MASTER_DATA=http://localhost:8002/api/v1
# Base URL for the terminal service
# e.g. http://terminal.myserver.com/api/v1
BASE_URL_TERMINAL=http://localhost:8001/api/v1

# < Auth >
#
# set the secret key same as the account service
SECRET_KEY=
# The algorithm used to sign the token
ALGORITHM=HS256
# account service token url
# e.g http://account.myserver.com/api/v1/accounts/token
TOKEN_URL=http://localhost:8000/api/v1/accounts/token
# set pubsb notify api key same as the terminal service
PUBSUB_NOTIFY_API_KEY=your_pubsub_notify_api_key

#
# < Slack Webhook >
#
# Slack Webhook URL for sending notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/sample/webhook/url

#
# < Publish-subscribe >
#
# undelivered check interval in minutes
# This is the interval at which the system checks for undelivered messages
UNDELIVERED_CHECK_INTERVAL_IN_MINUTES=5
# undelivered check period in hours
# This is the period after which undelivered messages are considered for reprocessing
UNDELIVERED_CHECK_PERIOD_IN_HOURS=24
# undelivered check failed period in minutes
# This is the period after which undelivered messages are considered failed
UNDELIVERED_CHECK_FAILED_PERIOD_IN_MINUTES=30

# Other environment variables
# ...
# Signed cart snapshot keys (issues #148 / #156)
#
# ***  GENERATE YOUR OWN. NEVER COPY A KEY FROM ANYWHERE PUBLIC.  ***
#
# This key is what stops a client from editing its own cart. Anyone who knows it
# can sign a snapshot with any prices they like, and the server will accept it.
#
#   python -c "import base64,os;print('v1:'+base64.b64encode(os.urandom(32)).decode())"
#
# Comma-separated "<kid>:<base64 key>" entries; the FIRST one signs, the rest stay
# valid so a key can be rotated without invalidating snapshots already in flight.
# Keys must be at least 32 bytes. REQUIRED: the cart service will not start
# without one (issue #192). A cart the client carries is held nowhere else, so a
# process that cannot sign cannot hand one back — it would take the cart with it.
#SNAPSHOT_HMAC_KEYS=v1:REPLACE_WITH_YOUR_OWN_BASE64_KEY

# Allow starting with the signing key committed to this repository (issue #192)
# That key signs and verifies, so every other signal looks healthy while the
# signature protects nothing: anyone reading the repo can mint a snapshot with any
# prices in it. Startup refuses it unless this says the stack is a development one.
# Never set this outside local development.
#SNAPSHOT_ALLOW_INSECURE_KEY=false

# Maximum request body size in bytes (issue #156, FR-009; issue #195)
# The ceiling every request body is held to, compressed or not: a compressed
# body that expands beyond it is rejected with 413 before the expansion
# completes, and an uncompressed one is refused as it is read. Enforced ahead of
# authentication, so it also bounds what an unauthenticated caller can make this
# worker hold.
#
# Sized from measurement, not from a round number: a 999-line transaction with
# distinct SKUs carries an 894 KB snapshot on every mutating request, and 1 MB
# refuses the same transaction at 1,221 lines. Compressing is not a way around
# it - the ceiling is enforced against the decompressed size.
MAX_REQUEST_BODY_BYTES=4194304

# Deprecated name for MAX_REQUEST_BODY_BYTES. Still honoured if set (it wins
# over the new name), so an existing deployment is not silently reset to the
# default; prefer the new name.
#REQUEST_DECOMPRESS_MAX_BYTES=

# Per-request snapshot mode (issue #156)
# DUAL     - accept requests without a carried snapshot (cache-authoritative path)
# REQUIRED - reject snapshot-less mutating requests; switch to this once every
#            client has migrated to phase 2
CART_REQUEST_SNAPSHOT_MODE=DUAL
