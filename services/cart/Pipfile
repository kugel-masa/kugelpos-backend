[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = "*"
python-dotenv = "*"
pydantic = "*"
pydantic-settings = "*"
motor = "*"
pytz = "*"
pyjwt = "*"
kugel_common = {file = "commons/dist/kugel_common-0.1.78-py3-none-any.whl"}
httpx = "*"
aiohttp = "*"
wcwidth = "*"
debugpy = "*"
apscheduler = "*"
# Request-body decompression for carried snapshots (issue #156, FR-009);
# .NET 8 clients send Content-Encoding: br by default.
brotli = "*"

[dev-packages]
pytest = "*"
pytest-asyncio = "*"
pytest-mock = "*"
respx = "*"
flake8 = "*"
black = "*"
mypy = "*"
locust = "*"
pandas = "*"

[requires]
python_version = "3.12"

[scripts]
lint = "flake8 app tests"
format = "black app tests"
typecheck = "mypy app"
