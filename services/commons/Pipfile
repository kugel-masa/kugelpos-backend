[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Runtime dependencies of kugel_common (declared here because they are
# needed to import the package during tests; kugel_common's pyproject.toml
# only declares a minimal subset because consuming services pin their own).
motor = "*"
grpcio = ">=1.60.0"
grpcio-tools = ">=1.60.0"
pyjwt = ">=2.0.0"
fastapi = "*"
httpx = "*"
aiohttp = "*"
pydantic = "*"
pydantic-settings = "*"
python-dotenv = "*"
pytz = "*"
passlib = {extras = ["bcrypt"], version = "*"}
bcrypt = "==3.2.0"
slack-sdk = "*"
wcwidth = "*"
apscheduler = "*"

[dev-packages]
pytest = "*"
pytest-asyncio = "*"
pytest-mock = "*"
respx = "*"
# Exercises the brotli branch of the request-decompression middleware; the
# middleware itself degrades gracefully when brotli is absent.
brotli = "*"

[requires]
python_version = "3.12"
