#
# < MongoDB >
#
# connection string
MONGODB_URI=your_mongodb_uri
# Database name
DB_NAME_PREFIX=your_database_name

# < Web Service >
#
# Base URL for the dapr sidecar
# e.g. http://localhost:3500/v1.0
BASE_URL_DAPR=http://localhost:3505/v1.0
# Base URL for the terminal service
# e.g. http://terminal.myserver.com/api/v1
BASE_URL_TERMINAL=http://localhost:8001/api/v1
# Base URL for the cart service
# e.g. http://cart.myserver.com/api/v1
BASE_URL_CART=http://localhost:8003/api/v1

#
# < Auth >
#
# set the secret key same as the account service
SECRET_KEY=
# The algorithm used to sign the token
ALGORITHM=HS256
# account service token url
# e.g http://account.myserver.com/api/v1/accounts/token 
TOKEN_URL=http://localhost:8000/api/v1/accounts/token
# set pubsb notify api key same as the terminal service
PUBSUB_NOTIFY_API_KEY=your_pubsub_notify_api_key

#
# < Slack Webhook >
#
# Slack Webhook URL for sending notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/sample/webhook/url

# Other environment variables
# ...

# < Request body limit >
#
# Maximum request body size in bytes (issue #195). Enforced outermost, ahead of
# authentication, so an unauthenticated caller cannot decide how much memory
# this worker spends. Larger bodies are refused with 413.
#
# Raised above the 1 MB default because the Dapr pub/sub tranlog subscriber is
# served by this same app: a refused event is retried and then dead-lettered,
# so a ceiling set too low loses the sale silently instead of failing visibly.
# A measured 999-line transaction publishes a 552 KB tranlog.
MAX_REQUEST_BODY_BYTES=4194304
